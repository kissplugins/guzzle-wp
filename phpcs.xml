<?xml version="1.0"?>
<ruleset name="Geekbench Scraper WordPress Plugin">
    <description>WordPress Coding Standards for Geekbench Scraper Plugin</description>

    <!-- What to scan -->
    <file>.</file>

    <!-- Exclude patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.md</exclude-pattern>
    <exclude-pattern>composer.phar</exclude-pattern>
    <exclude-pattern>debug-test.php</exclude-pattern>
    <exclude-pattern>*/.github/*</exclude-pattern>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>

    <!-- Show colors in output -->
    <arg name="colors"/>

    <!-- Check up to 8 files simultaneously -->
    <arg name="parallel" value="8"/>

    <!-- Only check PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Use WordPress Core Coding Standards (most stable) -->
    <rule ref="WordPress-Core">
        <!-- Allow short array syntax (modern PHP) -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Minimum WordPress version -->
    <config name="minimum_supported_wp_version" value="5.8"/>

    <!-- Check text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="geekbench-scraper"/>
            </property>
        </properties>
    </rule>

    <!-- Verify that everything in the global namespace is prefixed -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="geekbench_scraper"/>
                <element value="GeekbenchScraper"/>
            </property>
        </properties>
    </rule>

    <!-- Allow relaxed file naming -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>
</ruleset>

